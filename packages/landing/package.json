{
  "name": "@kaiord/landing",
  "private": true,
  "version": "4.3.2",
  "description": "Landing page for kaiord.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-locales.mjs && node scripts/build-sitemap.mjs",
    "i18n:extract": "node scripts/extract-strings.mjs",
    "preview": "vite preview",
    "test": "vitest --run",
    "lint:fix": "prettier --write src public index.html"
  },
  "dependencies": {
    "@kaiord/core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "jsdom": "^30.1.3",
    "node-html-parser": "^9.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
