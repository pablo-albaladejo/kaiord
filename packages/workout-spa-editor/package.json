{
  "name": "@kaiord/workout-spa-editor",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Mobile-first SPA for creating and editing KRD workout files",
  "types": "design-system.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:flakiness": "node scripts/measure-flakiness.js 100",
    "test:e2e:flakiness:quick": "node scripts/measure-flakiness.js 10",
    "test:e2e:flakiness:ios": "node scripts/measure-flakiness.js 100 'Mobile Safari'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc -b --noEmit && eslint . && prettier --check src e2e scripts/verify-prod",
    "lint:fix": "eslint . --fix && prettier --write src e2e scripts/verify-prod",
    "format": "prettier --write src e2e scripts/verify-prod",
    "format:check": "prettier --check src e2e scripts/verify-prod",
    "preview": "vite preview",
    "verify:prod": "node scripts/verify-prod/run.mjs",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.75",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.87",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kaiord/ai": "workspace:^",
    "@kaiord/core": "workspace:^",
    "@kaiord/fit": "workspace:^",
    "@kaiord/garmin": "workspace:^",
    "@kaiord/i18n": "workspace:^",
    "@kaiord/tanita": "workspace:^",
    "@kaiord/tcx": "workspace:^",
    "@kaiord/trainingpeaks": "workspace:^",
    "@kaiord/whoop": "workspace:^",
    "@kaiord/zwo": "workspace:^",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.16",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-toast": "^1.2.24",
    "ai": "^7.0.131",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.32",
    "wouter": "^3.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
