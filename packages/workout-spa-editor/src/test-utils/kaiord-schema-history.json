{
  "about": [
    "Frozen history of every Dexie version KaiordDatabase has ever declared (v1..v37), as of the schema-pruning change.",
    "Each entry holds only the stores that version changed (Dexie merges stores() declarations table by table, so this is equivalent to the full declaration) and whether it carried an upgrade function.",
    "Never edit an existing entry. Append one entry per new version. Tests in src/adapters/dexie/kaiord-schema-history*.test.ts read it."
  ],
  "versions": [
    {
      "version": 1,
      "upgrade": false,
      "stores": {
        "workouts": "id, date, [date+state], [source+sourceId], sport, *tags",
        "templates": "id, sport, *tags",
        "profiles": "id",
        "aiProviders": "id",
        "syncState": "source",
        "usage": "yearMonth",
        "meta": "key"
      }
    },
    {
      "version": 2,
      "upgrade": false,
      "stores": {
        "bridges": "extensionId, status, lastSeen"
      }
    },
    {
