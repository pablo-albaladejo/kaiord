{
  "name": "@kaiord/ai",
  "version": "9.3.1",
  "description": "AI/LLM integration for the Kaiord health & fitness data framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers.js",
      "types": "./dist/providers.d.ts"
    },
    "./prompts": {
      "import": "./dist/prompts.js",
      "types": "./dist/prompts.d.ts"
    },
    "./agents": {
      "import": "./dist/agents.js",
      "types": "./dist/agents.d.ts"
    },
    "./observability": {
      "import": "./dist/observability.js",
      "types": "./dist/observability.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint . && prettier --check src",
    "lint:fix": "eslint . --fix && prettier --write src",
    "eval": "echo 'INERT: needs a provider API key this project does not have. See the runner header.' && tsx src/evals/run-evals.ts",
    "eval:chat-tools": "echo 'INERT: needs a provider API key this project does not have. See the runner header.' && tsx src/evals/run-chat-tool-evals.ts",
    "eval:labs": "echo 'INERT: needs a provider API key this project does not have. See the runner header.' && tsx src/evals/run-lab-extraction-evals.ts",
    "generate:model-catalog": "node scripts/generate-model-catalog.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kaiord/core": "workspace:^",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.58",
    "ai": "^7.0.92"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/openai": "^4.0.58",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ai": "^7.0.92",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pablo-albaladejo/kaiord.git",
    "directory": "packages/ai"
  },
  "homepage": "https://www.npmjs.com/package/@kaiord/ai",
  "bugs": {
    "url": "https://github.com/pablo-albaladejo/kaiord/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "kaiord",
    "ai",
    "llm",
    "workout",
    "fitness",
    "structured-output"
  ],
  "author": "Kaiord Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
