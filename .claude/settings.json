{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "mcp__context7__*",
      "mcp__ide__getDiagnostics",
      "mcp__kaiord__*",
      "mcp__playwright__*",
      "mcp__vitest__*",
      "Read",
      "Skill(*)",
      "Task",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~/*)",
      "Bash(yarn publish*)",
      "Bash(npm unpublish*)",
      "Bash(pnpm exec changeset publish*)",
      "Bash(npx changeset publish*)",
      "Bash(git push --tags*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh workflow disable*)",
      "mcp__kaiord__kaiord_garmin_push"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/check-docs-sync.sh",
            "if": "Bash(git commit*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/never-auto-remediate.cjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-approval-guard.cjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-architecture.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-schema-naming.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-file-size.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-test-needed.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/related-tests-stop.cjs",
            "timeout": 240
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-human-approval.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/related-tests-stop.cjs",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
