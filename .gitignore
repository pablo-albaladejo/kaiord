# Dependencies
# Match both directories and symlinks named node_modules: a trailing-slash
# pattern ignores only directories, so a node_modules SYMLINK (e.g. one that
# leaks in from a sibling worktree via `git add -A`) would slip past it.
node_modules
node_modules/

# Build outputs
dist/
*.tsbuildinfo
storybook-static/

# Test coverage
coverage/
coverage-summary.json
*.coverage.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local
# The SPA editor .env holds only the PUBLIC Google OAuth client id (not a
# secret) and is committed as the default for cross-device sync.
!packages/workout-spa-editor/.env

# Quality metrics (generated, keep history only)
metrics/latest/
metrics/DASHBOARD.md
!metrics/.gitkeep
!metrics/latest/.gitkeep

# Claude Code worktrees
.claude/worktrees/
.claude/settings.local.json

# oh-my-claudecode runtime (state, sessions, notepad, plans, research, logs)
.omc/

# GitHub Actions local testing (act)
.secrets
.actrc.local
.playwright-mcp/

# Metrics (generated)
.metrics/
.jscpd-report/
metrics-*.json

# CDK
cdk.out/

# PoC directories (local experiments, not committed)
poc-*/

# OpenSpec
openspec/.cache/
packages/docs/.vitepress/cache/
*.gcn
.claude/scheduled_tasks.lock

# Self-improve git worktrees
worktrees/

# understand-anything CLI knowledge graph (local tool, not part of repo)
.understand-anything/

# claude.ai/design sync (see .design-sync/NOTES.md).
# Committed: .design-sync/{config.json,NOTES.md,conventions.md,gen-entry.mjs,
# previews/,overrides/} — the inputs a future sync reuses. Everything below is
# regenerated build output, verification scratch, or a per-clone symlink.
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
# Compiled by .design-sync/build-css.mjs. Lives inside the package because the
# converter bounds cfg.cssEntry to the package root.
packages/workout-spa-editor/.design-sync-styles.css
